wasm := "{{ wasm_filename }}"
{% raw %}
act := env("ACT", "npx @actcore/act")
actbuild := env("ACT_BUILD", "npx @actcore/act-build")

build:
    uv run componentize-py -d wit -w component-world componentize app -o {{wasm}}

pack: build
    {{actbuild}} pack {{wasm}}

test: pack
    {{act}} call {{wasm}} hello --args '{"name":"act"}'
{% endraw %}
